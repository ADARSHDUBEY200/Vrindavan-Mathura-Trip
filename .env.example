# Public site configuration — copy to .env.local and fill in real values.
# Anything left blank is hidden on the site (no placeholder numbers are ever shown).

# Canonical URL of the live site, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_BRAND_NAME=Braj Dham Yatra

# WhatsApp number in international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone number as you want it displayed and dialled (e.g. +91 98765 43210)
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=

# Optional postal address (shown in the footer, contact page and schema)
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_LOCALITY=
NEXT_PUBLIC_ADDRESS_REGION=Uttar Pradesh
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=
NEXT_PUBLIC_ADDRESS_COUNTRY=IN

# Optional social profile URLs
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Server-only: optional webhook (Zapier, Make, Google Apps Script, Slack…) that
# receives each enquiry as JSON. Without it, enquiries are only logged on the
# server and visitors are asked to send their details on WhatsApp instead.
ENQUIRY_WEBHOOK_URL=
